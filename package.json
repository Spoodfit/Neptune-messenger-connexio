{
  "name": "neptune-messenger-connexio",
  "version": "1.0.0-rc.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export -p web",
    "web:serve": "expo serve",
    "lint": "node scripts/source-quality-audit.cjs",
    "typecheck": "tsc --noEmit",
    "test:clean": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test:compile": "npm run test:clean && tsc -p tsconfig.tests.json",
    "test": "npm run test:compile && node --test .test-dist/tests/*.test.js tests-node/*.test.cjs",
    "test:coverage": "npm run test:compile && node --experimental-test-coverage --test-coverage-include=\".test-dist/src/**/*.js\" --test-coverage-lines=88 --test-coverage-branches=68 --test-coverage-functions=77 --test .test-dist/tests/*.test.js tests-node/*.test.cjs",
    "test:domain": "npm test",
    "audit:i18n": "node scripts/i18n-coverage-audit.cjs",
    "audit:i18n-locale": "node scripts/i18n-locale-audit.cjs",
    "audit:embedded-content": "node scripts/embedded-content-security-audit.cjs",
    "audit:workflows": "node scripts/workflow-governance-audit.cjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run audit:embedded-content && npm run audit:workflows && node scripts/theme-contrast-audit.cjs && npm run audit:i18n && npm run audit:i18n-locale",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild",
    "audit:dependencies": "node scripts/npm-production-audit.cjs",
    "audit:rc": "node scripts/release-candidate-audit.cjs",
    "audit:production": "node scripts/production-config-audit.cjs",
    "smoke:backend": "node scripts/neptune-backend-smoke.cjs",
    "smoke:production": "CONNEXIO_SMOKE_MODE=production node scripts/neptune-backend-smoke.cjs",
    "verify:rc": "npm run verify && npm run audit:dependencies && npm run audit:rc && npm run audit:production && npx expo install --check",
    "build:preview": "eas build --profile preview --platform all",
    "build:backend-smoke": "eas build --profile backend-smoke --platform all",
    "build:rc": "npm run smoke:production && eas build --profile release-candidate --platform all",
    "build:production": "npm run smoke:production && eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.13",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.0",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}

{
  "name": "neptune-messenger-connexio",
  "version": "1.0.0-rc.1",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-image-picker",
        "expo-location",
        "expo-notifications",
        "expo-router",
        "expo-splash-screen"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export -p web",
    "web:serve": "expo serve",
    "typecheck": "tsc --noEmit",
    "test:clean": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test:compile": "npm run test:clean && tsc -p tsconfig.tests.json",
    "test": "npm run test:compile && node --test .test-dist/tests/*.test.js",
    "test:domain": "npm test",
    "audit:i18n": "node scripts/i18n-coverage-audit.cjs",
    "audit:i18n-locale": "node scripts/i18n-locale-audit.cjs",
    "verify": "npm run typecheck && npm test && node scripts/theme-contrast-audit.cjs && npm run audit:i18n && npm run audit:i18n-locale",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild",
    "audit:dependencies": "node scripts/npm-production-audit.cjs",
    "audit:rc": "node scripts/release-candidate-audit.cjs",
    "smoke:backend": "node scripts/neptune-backend-smoke.cjs",
    "verify:rc": "npm run verify && npm run audit:dependencies && npm run audit:rc && npx expo install --check",
    "build:preview": "eas build --profile preview --platform all",
    "build:rc": "eas build --profile release-candidate --platform all",
    "build:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.10",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.10",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.0",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
